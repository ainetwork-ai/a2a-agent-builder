# Docker Compose Environment Variables Template
# Copy this file to .env and fill in your values

# Application Configuration
NEXT_PUBLIC_SITE_URL=http://localhost:3001
PORT=3001

# LLM API Configuration
LLM_API_URL=https://your-llm-api-url/v1/chat/completions
LLM_MODEL=/path/to/your/model
NODE_TLS_REJECT_UNAUTHORIZED=0

# Redis is automatically configured by docker-compose
# REDIS_URL=redis://redis:6379

# GCS (intent image upload)
GCS_BUCKET_NAME=
# Path (inside the container) to a mounted service account key JSON with
# Storage Object Admin/Creator on the bucket. Mount the key via docker volume.
GOOGLE_APPLICATION_CREDENTIALS=/app/gcs-key.json
# NOTE: no object-level ACL is set; grant public read at the bucket IAM level
# (allUsers -> Storage Object Viewer) since the shared bucket uses UBLA.

# Admin SIWE + JWT auth
ADMIN_WALLETS=
JWT_SECRET=
ADMIN_DASHBOARD_URL=
ADMIN_RPC_URL=

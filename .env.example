# public (next.js / frontend)
NEXT_PUBLIC_SITE_URL=http://localhost:3001
NEXT_PUBLIC_API_BASE_URL=
NEXT_PUBLIC_SENTRY_DSN=

# server
PORT=3001
NODE_TLS_REJECT_UNAUTHORIZED=0

# llm
LLM_API_URL=https://your-llm-api-url/v1/chat/completions
LLM_MODEL=/path/to/your/model

GEMINI_API_KEY=

AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_KEY=
AZURE_OPENAI_API_VERSION=
AZURE_OPENAI_MODEL=

# redis
REDIS_URL=redis://localhost:6379

# gcs (intent image upload)
# Bucket where uploaded intent images are stored (objects under
# intent-images/{env}/{agentId}/, where env = production|develop from NEXT_PUBLIC_NODE_ENV).
GCS_BUCKET_NAME=
# Credentials — use ONE of the following:
#  (a) Absolute path to a service account key JSON (Storage Object Admin/Creator on the bucket):
GOOGLE_APPLICATION_CREDENTIALS=
#  (b) Inline service account key as raw JSON or base64 (base64 recommended to avoid newline
#      issues in private_key). Takes precedence over (a). Never commit a real value.
GCS_CREDENTIALS_JSON=
#  (c) Or run `gcloud auth application-default login` (ADC) and leave both empty.
# NOTE: no object-level ACL is set. The shared bucket uses uniform bucket-level access
# (UBLA), so grant public read at the bucket IAM level (allUsers -> Storage Object Viewer,
# ideally scoped to the intent-images/ prefix). Images live under intent-images/{env}/{agentId}/.

# admin (SIWE + JWT auth)
# CSV of allowed admin wallet addresses (Coinbase Smart Wallet, lowercase or checksum)
ADMIN_WALLETS=
# HS256 signing key — generate with: openssl rand -base64 32
JWT_SECRET=
# Dashboard origin for CORS + SIWE domain enforcement
ADMIN_DASHBOARD_URL=
# Base mainnet RPC (optional, defaults to https://mainnet.base.org)
ADMIN_RPC_URL=
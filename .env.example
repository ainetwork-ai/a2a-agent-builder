# public (next.js / frontend)
NEXT_PUBLIC_SITE_URL=http://localhost:3001
NEXT_PUBLIC_API_BASE_URL=
NEXT_PUBLIC_SENTRY_DSN=

# server
PORT=3001
NODE_TLS_REJECT_UNAUTHORIZED=0

# llm
LLM_API_URL=https://your-llm-api-url/v1/chat/completions
LLM_MODEL=/path/to/your/model

GEMINI_API_KEY=

AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_KEY=
AZURE_OPENAI_API_VERSION=
AZURE_OPENAI_MODEL=

# redis
REDIS_URL=redis://localhost:6379

# gcs (intent image upload)
# Bucket where uploaded intent images are stored (objects under intent-images/{agentId}/).
GCS_BUCKET_NAME=
# Absolute path to a service account key JSON with Storage Object Admin/Creator on the bucket.
# Alternatively run `gcloud auth application-default login` for ADC and leave this empty.
GOOGLE_APPLICATION_CREDENTIALS=
# NOTE: the bucket must grant public read (allUsers -> Storage Object Viewer) so the
# returned https://storage.googleapis.com/<bucket>/<object> URLs load in the browser.

# admin (SIWE + JWT auth)
# CSV of allowed admin wallet addresses (Coinbase Smart Wallet, lowercase or checksum)
ADMIN_WALLETS=
# HS256 signing key — generate with: openssl rand -base64 32
JWT_SECRET=
# Dashboard origin for CORS + SIWE domain enforcement
ADMIN_DASHBOARD_URL=
# Base mainnet RPC (optional, defaults to https://mainnet.base.org)
ADMIN_RPC_URL=
# Vercel Environment Variables Template
# Set these in Vercel Project Settings > Environment Variables

# Application Configuration
NEXT_PUBLIC_SITE_URL=https://your-app.vercel.app
PORT=3001

# LLM API Configuration
LLM_API_URL=https://your-llm-api-url/v1/chat/completions
LLM_MODEL=/path/to/your/model
NODE_TLS_REJECT_UNAUTHORIZED=0

# Upstash Redis Configuration (for Vercel)
# Get these from: https://console.upstash.com/
KV_REST_API_URL=https://your-redis-url.upstash.io
KV_REST_API_TOKEN=your_kv_rest_api_token

# GCS (intent image upload)
GCS_BUCKET_NAME=
# Serverless caveat: the code authenticates via GOOGLE_APPLICATION_CREDENTIALS (a file
# path), which Vercel does not provide out of the box. Provide credentials via ADC-
# compatible setup (e.g. write the key to a tmp file at boot, or adapt gcsUpload.ts to
# accept inline JSON). Bucket must grant public read (allUsers -> Storage Object Viewer).

# Admin SIWE + JWT auth
ADMIN_WALLETS=
JWT_SECRET=
ADMIN_DASHBOARD_URL=https://your-admin-dashboard.example.com
ADMIN_RPC_URL=

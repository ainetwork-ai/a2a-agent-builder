# Vercel Environment Variables Template
# Set these in Vercel Project Settings > Environment Variables

# Application Configuration
NEXT_PUBLIC_SITE_URL=https://your-app.vercel.app
PORT=3001

# LLM API Configuration
LLM_API_URL=https://your-llm-api-url/v1/chat/completions
LLM_MODEL=/path/to/your/model
NODE_TLS_REJECT_UNAUTHORIZED=0

# Upstash Redis Configuration (for Vercel)
# Get these from: https://console.upstash.com/
KV_REST_API_URL=https://your-redis-url.upstash.io
KV_REST_API_TOKEN=your_kv_rest_api_token

# GCS (intent image upload)
GCS_BUCKET_NAME=
# On Vercel, prefer inline credentials (no key file on disk): set the service account
# key as base64-encoded JSON (recommended) or raw JSON. Objects are uploaded with a
# public-read ACL, so the bucket must be fine-grained (object ACLs enabled, NOT UBLA).
GCS_CREDENTIALS_JSON=

# Admin SIWE + JWT auth
ADMIN_WALLETS=
JWT_SECRET=
ADMIN_DASHBOARD_URL=https://your-admin-dashboard.example.com
ADMIN_RPC_URL=
